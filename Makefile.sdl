CROSS_COMPILE ?=
ifneq ($(strip $(CROSS_COMPILE)),)
ifeq ($(origin CC),default)
CC := $(CROSS_COMPILE)gcc
endif
endif
PKG_CONFIG ?= pkg-config
TARGET_TRIPLE := $(shell $(CC) -dumpmachine)

BUILD ?= build/sdl
ifneq ($(findstring wasm32,$(TARGET_TRIPLE)),)
TARGET ?= $(BUILD)/nzportable.js
else
TARGET ?= $(BUILD)/nzportable
endif
DATA_DIR ?= build/data
CPPFLAGS := -Isource -I$(BUILD) -DGLQUAKE -DPLATFORM_SDL -DPLATFORM_CONFIRM_IS_ENTER \
			-DGL_SILENCE_DEPRECATION -DPLATFORM_DIRECTORY=sdl -DPLATFORM_RENDERER=gl \
			-DMAX_AI_COUNT=24 -DPLATFORM_USES_GENERIC_GLYPHS -DPLATFORM_SUPPORTS_HIGH_FRAMERATES \
			-DPLATFORM_SUPPORTS_VIDEO_OPTIONS -DPLATFORM_SUPPORTS_GYRO -DPLATFORM_SUPPORTS_RUMBLE \
			-DPLATFORM_SUPPORTS_LIGHTBAR
CFLAGS ?= -O2 -g
CFLAGS += -std=gnu99 -Wall -Wno-unused-variable -Wno-unused-but-set-variable $(shell $(PKG_CONFIG) --cflags sdl2 | sed 's/-Dmain=SDL_main//')
ifneq ($(findstring clang,$(shell $(CC) --version)),)
CFLAGS += -Wno-unknown-warning-option -Wno-unknown-pragmas
endif
ifeq ($(WERROR),1)
CFLAGS += -Werror
endif
ifeq ($(findstring wasm32,$(TARGET_TRIPLE)),)
LDLIBS := $(shell $(PKG_CONFIG) --libs sdl2) -lSDL2_mixer
else
# no --embed-file $HOME/nzp@nzp cause we don't want to do that here
LDLIBS := -sUSE_SDL=2 -sUSE_SDL_MIXER=2 -sSDL2_MIXER_FORMATS='["mp3"]' 
LDLIBS += -sFORCE_FILESYSTEM -sINITIAL_MEMORY=256mb -sSTACK_SIZE=1mb
LDLIBS += -sLEGACY_GL_EMULATION -sGL_FFP_ONLY -gsource-map

CFLAGS += -sUSE_SDL=2 -sUSE_SDL_MIXER=2 -sSDL2_MIXER_FORMATS='["mp3"]' 
CFLAGS += -gsource-map
endif
LDLIBS +=  -lm
ifneq ($(findstring mingw,$(TARGET_TRIPLE)),)
LDLIBS += -static \
	-lopengl32 \
	-lglu32 \
	-lws2_32 \
	-lsetupapi \
	-lole32 \
	-loleaut32 \
	-limm32 \
	-lversion \
	-lcfgmgr32 \
	-lwinmm \
	-luuid
else ifeq ($(shell uname -s),Darwin)
LDLIBS += -framework OpenGL
else ifneq ($(findstring wasm32,$(TARGET_TRIPLE)),)
else
LDLIBS += -lGL -lGLU
endif

ENGINE_SOURCES := $(wildcard source/*.c) $(wildcard source/menu/*.c) $(wildcard source/qcvm/*.c) $(wildcard source/render/*.c) $(wildcard source/tests/*.c)
SDL_SOURCES := $(wildcard source/platform/sdl/*.c) $(wildcard source/platform/sdl/gl/*.c)
SOURCES := $(filter-out source/render/r_model_soft.c,$(ENGINE_SOURCES)) $(SDL_SOURCES)
OBJECTS := $(patsubst source/%.c,$(BUILD)/%.o,$(SOURCES))

.PHONY: all clean run
all: $(TARGET)

$(OBJECTS): source/nzportable_def.h

$(BUILD)/_build_info.h:
	@mkdir -p $(@D)
	@{ echo '#define GIT_HASH "$(shell git rev-parse --short HEAD)$(shell git diff --quiet || echo -dirty)"'; \
	   echo '#define GIT_BRANCH "$(shell git rev-parse --abbrev-ref HEAD)"'; \
	   echo '#define BUILD_DATE "$(shell date -u +%Y-%m-%dT%H:%M:%SZ)"'; } > $@

$(TARGET): $(OBJECTS)
	$(CC) $(OBJECTS) $(LDLIBS) -o $@

$(BUILD)/%.o: source/%.c $(BUILD)/_build_info.h
	@mkdir -p $(@D)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

run: $(TARGET)
	./$(TARGET) -basedir $(DATA_DIR)

clean:
	rm -rf $(BUILD)

$(BUILD)/render/r_screen.o: source/render/r_alias_lerp.h