; I am really standing on the shoulders of giants here, this is a mess of 
; a bunch of samples mashed together and loosely following manuals and docs.
; Seriously, I take no credit.
; --
; * https://github.com/ps2dev/ps2sdk/blob/2a18d15da1332665451a9bcf9a0d4df9029c9490/ee/draw/samples/vu1/draw_3D.vsm
; * https://lukasz.dk/files/vu-instruction-manual.pdf
; * https://www.mikekohn.net/software/playstation2.php
; * https://psi-rockin.github.io/ps2tek/#vu
#include "gs_vu1_layout.h"
.vu
.align 4
.macro VU_WAIT count
.rept \count
        NOP                         NOP
.endr
.endm

.global VU1_CodeStart
.global VU1_CodeEnd
VU1_CodeStart:
        NOP                         iaddiu VI01,VI00,(VU1_Triangle-VU1_CodeStart)
        NOP                         isw.x VI01,VU_ENTRY(VI00)
        NOP                         isw.y VI00,VU_SCRATCH(VI00)
        NOP                         lq VF01,VU_MATRIX(VI00)
        NOP                         lq VF02,1(VI00)
        NOP                         lq VF03,2(VI00)
        NOP                         lq VF04,3(VI00)
        NOP                         lq VF05,VU_SCALE(VI00)
        NOP                         lq VF06,VU_OFFSET(VI00)
        NOP                         lq VF07,VU_FOG(VI00)
        NOP                         lq VF10,VU_COLOR_SCALE(VI00)
        NOP                         lq VF11,VU_UV(VI00)
        NOP                         lq VF16,VU_ROUNDING(VI00)
        NOP                         iaddiu VI14,VI00,VU_INPUT
        NOP                         ilw.x VI02,VU_COUNTS(VI00)
        NOP                         ilw.z VI06,VU_COUNTS(VI00)
        NOP                         ilw.z VI03,VU_ENTRY(VI00)
        NOP                         iaddiu VI01,VI00,VU_PACKET0
        NOP                         NOP
        NOP                         ibeq VI03,VI01,VU1_PacketReady
        NOP                         iaddiu VI01,VI00,VU_PACKET1
        NOP                         NOP
        NOP                         ibeq VI03,VI01,VU1_PacketReady
        NOP                         NOP
        NOP                         iaddiu VI03,VI00,VU_PACKET0
VU1_PacketReady:
        NOP                         ilw.w VI12,VU_COUNTS(VI00)
        NOP                         NOP
        NOP                         ibltz VI12,VU1_AliasBegin
        NOP                         NOP
        NOP                         iaddiu VI01,VI00,VU_FLAG_INDEXED
        NOP                         iand VI01,VI12,VI01
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_WorldBegin
        NOP                         NOP
        NOP                         iaddiu VI01,VI00,VU_FLAG_STREAM
        NOP                         iand VI01,VI12,VI01
        NOP                         NOP
        NOP                         ibeq VI01,VI00,VU1_Begin
        NOP                         NOP
        NOP                         lq VF18,VU_COLOR(VI00)
        NOP                         NOP
        maxx VF18,VF18,VF00x       NOP
        miniw VF18,VF18,VF00w      NOP
        mul VF18,VF18,VF10         NOP
VU1_Begin:
        NOP                         iaddiu VI15,VI00,128
VU1_Triangle:
        NOP                         iaddiu VI04,VI00,VU_WORK
        NOP                         iaddiu VI05,VI00,3
        NOP                         iadd VI09,VI04,VI00
        NOP                         iadd VI08,VI05,VI00
        NOP                         ilw.w VI12,VU_COUNTS(VI00)
        NOP                         NOP
        NOP                         ibltz VI12,VU1_IndexedTriangle
        NOP                         NOP
        NOP                         iaddiu VI01,VI00,VU_FLAG_INDEXED
        NOP                         iand VI01,VI12,VI01
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_IndexedTriangle
        NOP                         NOP
        NOP                         iaddiu VI01,VI00,VU_FLAG_STREAM
        NOP                         iand VI01,VI12,VI01
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_StreamTransform
        NOP                         NOP
        NOP                         b VU1_Transform
        NOP                         NOP
VU1_StreamTransform:
        NOP                         lq VF20,0(VI14)
        NOP                         lq VF21,1(VI14)
        addx VF22,VF18,VF00x        NOP
        mulax ACC,VF01,VF20x        NOP
        madday ACC,VF02,VF20y       NOP
        maddaz ACC,VF03,VF20z       NOP
        maddw VF23,VF04,VF20w       NOP
        mul.xy VF21,VF21,VF11      NOP
        addz.x VF21,VF21,VF11z     NOP
        addw.y VF21,VF21,VF11w     NOP
        subw.z VF21,VF07,VF23w     NOP
        mulx.z VF21,VF21,VF07x     NOP
        clipw.xyz VF23,VF23w       NOP
        maxy.z VF21,VF21,VF07y     NOP
        miniw.z VF21,VF21,VF07w    NOP
        NOP                         sq VF23,0(VI09)
        NOP                         sq VF21,1(VI09)
        NOP                         sq VF22,2(VI09)
        NOP                         iaddiu VI14,VI14,3
        NOP                         iaddiu VI09,VI09,3
        NOP                         isubiu VI08,VI08,1
        NOP                         NOP
        NOP                         ibne VI08,VI00,VU1_StreamTransform
        NOP                         NOP
        NOP                         iaddiu VI06,VI00,VU_STREAM_CLIP
        NOP                         b VU1_ClipTriangle
        NOP                         NOP
VU1_Transform:
        NOP                         lq VF20,0(VI14)
        NOP                         lq VF21,1(VI14)
        NOP                         lq VF22,2(VI14)
VU1_Matrix:
        mulax ACC,VF01,VF20x        NOP
        madday ACC,VF02,VF20y       NOP
        maddaz ACC,VF03,VF20z       NOP
        maddw VF23,VF04,VF20w       NOP
        mul.xy VF21,VF21,VF11      NOP
        maxx VF22,VF22,VF00x       NOP
        miniw VF22,VF22,VF00w      NOP
        mul VF22,VF22,VF10         NOP
        addz.x VF21,VF21,VF11z     NOP
        addw.y VF21,VF21,VF11w     NOP
        subw.z VF21,VF07,VF23w     NOP
        mulx.z VF21,VF21,VF07x     NOP
        clipw.xyz VF23,VF23w       NOP
        maxy.z VF21,VF21,VF07y     NOP
        miniw.z VF21,VF21,VF07w    NOP
        NOP                         sq VF23,0(VI09)
        NOP                         sq VF21,1(VI09)
        NOP                         sq VF22,2(VI09)
        NOP                         iaddiu VI14,VI14,3
        NOP                         iaddiu VI09,VI09,3
        NOP                         isubiu VI08,VI08,1
        NOP                         NOP
        NOP                         ibne VI08,VI00,VU1_Transform
        NOP                         NOP
        NOP                         iaddiu VI06,VI00,VU_STREAM_CLIP
VU1_ClipTriangle:
        NOP                         fcand VI01,0x3ffff
        VU_WAIT 2
        NOP                         ibeq VI01,VI00,VU1_Output
        NOP                         iaddiu VI07,VI00,VU_PLANES
        NOP                         fcor VI01,0xffefbe
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_TriangleDone
        NOP                         NOP
        NOP                         fcor VI01,0xffdf7d
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_TriangleDone
        NOP                         NOP
        NOP                         fcor VI01,0xffbefb
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_TriangleDone
        NOP                         NOP
        NOP                         fcor VI01,0xff7df7
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_TriangleDone
        NOP                         NOP
        NOP                         fcor VI01,0xfefbef
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_TriangleDone
        NOP                         NOP
        NOP                         fcor VI01,0xfdf7df
        NOP                         NOP
        NOP                         ibne VI01,VI00,VU1_TriangleDone
        NOP                         NOP
        NOP                         fcand VI01,0x20820
        NOP                         NOP
        NOP                         isw.z VI01,VU_SCRATCH(VI00)
.macro vril_clip_plane mask, plane, next
        NOP                         fcand VI01,\mask
        NOP                         ilw.z VI12,VU_SCRATCH(VI00)
        NOP                         NOP
        NOP                         ior VI01,VI01,VI12
        NOP                         NOP
        NOP                         ibeq VI01,VI00,\next
        NOP                         iaddiu VI07,VI00,\plane
        NOP                         bal VI01,VU1_Plane
        NOP                         NOP
.endm
VU1_CheckPlane0:
        vril_clip_plane 0x2082,11,VU1_CheckPlane1
VU1_CheckPlane1:
        vril_clip_plane 0x1041,12,VU1_CheckPlane2
VU1_CheckPlane2:
        vril_clip_plane 0x8208,13,VU1_CheckPlane3
VU1_CheckPlane3:
        vril_clip_plane 0x4104,14,VU1_CheckPlane4
VU1_CheckPlane4:
        vril_clip_plane 0x20820,15,VU1_CheckPlane5
VU1_CheckPlane5:
        vril_clip_plane 0x10410,16,VU1_CheckPlane6
VU1_CheckPlane6:
        NOP                         b VU1_Output
        NOP                         NOP
VU1_Plane:
        NOP                         lq VF08,0(VI07)
        NOP                         iadd VI09,VI04,VI00
        NOP                         iadd VI10,VI06,VI00
        NOP                         iadd VI08,VI05,VI00
        NOP                         iadd VI11,VI00,VI00
VU1_Edge:
        NOP                         lq VF20,0(VI09)
        NOP                         lq VF21,1(VI09)
        NOP                         lq VF22,2(VI09)
        NOP                         iaddiu VI09,VI09,3
        NOP                         isubiu VI08,VI08,1
        NOP                         NOP
        NOP                         ibne VI08,VI00,VU1_NextEdge
        NOP                         iadd VI13,VI09,VI00
        NOP                         iadd VI13,VI04,VI00
VU1_NextEdge:
        mul VF09,VF20,VF08          lq VF23,0(VI13)
        NOP                         lq VF24,1(VI13)
        NOP                         lq VF25,2(VI13)
        NOP                         NOP
        addy.x VF09,VF09,VF09y     NOP
        VU_WAIT 3
        addz.x VF09,VF09,VF09z     NOP
        VU_WAIT 3
        addw.x VF09,VF09,VF09w     NOP
        mul VF12,VF23,VF08          NOP
        VU_WAIT 2
        NOP                         fmand VI12,VI15
        addy.x VF12,VF12,VF12y     NOP
        VU_WAIT 3
        addz.x VF12,VF12,VF12z     NOP
        VU_WAIT 3
        addw.x VF12,VF12,VF12w     NOP
        VU_WAIT 3
        NOP                         fmand VI13,VI15
        NOP                         NOP
        NOP                         ibne VI12,VI00,VU1_Intersection
        NOP                         NOP
        NOP                         sq VF20,0(VI10)
        NOP                         sq VF21,1(VI10)
        NOP                         sq VF22,2(VI10)
        NOP                         iaddiu VI10,VI10,3
        NOP                         iaddiu VI11,VI11,1
VU1_Intersection:
        sub.x VF13,VF09,VF12        NOP
        NOP                         NOP
        NOP                         ibeq VI12,VI13,VU1_EdgeDone
        NOP                         NOP
        sub VF23,VF23,VF20          NOP
        sub VF24,VF24,VF21          NOP
        sub VF25,VF25,VF22          div Q,VF09x,VF13x
        NOP                         waitq
        mulq VF23,VF23,Q            NOP
        mulq VF24,VF24,Q            NOP
        mulq VF25,VF25,Q            NOP
        NOP                         NOP
        add VF23,VF23,VF20          NOP
        add VF24,VF24,VF21          NOP
        add VF25,VF25,VF22          NOP
        NOP                         NOP
        NOP                         sq VF23,0(VI10)
        NOP                         sq VF24,1(VI10)
        NOP                         sq VF25,2(VI10)
        NOP                         iaddiu VI10,VI10,3
        NOP                         iaddiu VI11,VI11,1
VU1_EdgeDone:
        NOP                         NOP
        NOP                         ibne VI08,VI00,VU1_Edge
        NOP                         NOP
        NOP                         iadd VI13,VI04,VI00
        NOP                         iadd VI04,VI06,VI00
        NOP                         iadd VI06,VI13,VI00
        NOP                         iadd VI05,VI11,VI00
        NOP                         isubiu VI13,VI05,3
        NOP                         NOP
        NOP                         ibltz VI13,VU1_TriangleDone
        NOP                         NOP
        NOP                         jr VI01
        NOP                         NOP
VU1_Output:
        NOP                         iadd VI11,VI05,VI00
        NOP                         iadd VI09,VI04,VI00
        NOP                         ilw.y VI12,VU_COUNTS(VI00)
        NOP                         ilw.z VI06,VU_COUNTS(VI00)
        NOP                         iaddiu VI07,VI00,VU_FOG_VERTICES
        NOP                         iaddiu VI10,VI00,VU_PROJECTED
        NOP                         ibeq VI06,VI00,VU1_OutputDirect
        NOP                         NOP
        NOP                         ilw.w VI13,VU_COUNTS(VI00)
        NOP                         iaddiu VI01,VI00,VU_FLAG_BATCH
        NOP                         iand VI13,VI13,VI01
        NOP                         NOP
        NOP                         ibeq VI13,VI00,VU1_Project
        NOP                         NOP
        NOP                         iadd VI08,VI05,VI00
        NOP                         iaddiu VI10,VI00,VU_CLIP0
VU1_CopyPassPolygon:
        NOP                         lq VF20,0(VI09)
        NOP                         lq VF21,1(VI09)
        NOP                         lq VF22,2(VI09)
        NOP                         NOP
        NOP                         sq VF20,0(VI10)
        NOP                         sq VF21,1(VI10)
        NOP                         sq VF22,2(VI10)
        NOP                         iaddiu VI09,VI09,3
        NOP                         iaddiu VI10,VI10,3
        NOP                         isubiu VI08,VI08,1
        NOP                         NOP
        NOP                         ibne VI08,VI00,VU1_CopyPassPolygon
        NOP                         NOP
        NOP                         iaddiu VI04,VI00,VU_CLIP0
        NOP                         iadd VI09,VI04,VI00
        NOP                         iadd VI10,VI04,VI00
        NOP                         iaddiu VI07,VI00,VU_CLIP_FOG
        NOP                         b VU1_Project
        NOP                         NOP
VU1_OutputDirect:
        NOP                         lq VF14,VU_GIFTAG(VI00)
        NOP                         iaddiu VI13,VI05,0x4000
        NOP                         iaddiu VI13,VI13,0x4000
        NOP                         iaddiu VI10,VI03,1
        NOP                         sq VF14,0(VI03)
        NOP                         isw.x VI13,0(VI03)
VU1_Project:
        NOP                         lq VF23,0(VI09)
        NOP                         lq VF21,1(VI09)
        NOP                         lq VF22,2(VI09)
        subw.xyz VF24,VF00,VF23w   NOP
        miniw.xyz VF23,VF23,VF23w  NOP
        max.xyz VF23,VF23,VF24      NOP
        NOP                         div Q,VF00w,VF23w
        NOP                         waitq
        mulq.xyz VF23,VF23,Q        NOP
        mulq.xy VF21,VF21,Q         NOP
        sub.w VF21,VF00,VF00        NOP
        VU_WAIT 3
        addq.w VF21,VF21,Q          NOP
        NOP                         NOP
        mul.xyz VF23,VF23,VF05      NOP
        VU_WAIT 3
        add.xyz VF23,VF23,VF06      NOP
        VU_WAIT 3
        mulz.w VF23,VF00,VF21z     NOP
        NOP                         NOP
        NOP                         ibeq VI12,VI00,VU1_ColorDone
        NOP                         isubiu VI13,VI12,2
        NOP                         NOP
        NOP                         ibltz VI13,VU1_ColorDone
        VU_WAIT 2
        NOP                         ibne VI13,VI00,VU1_Overlay
        NOP                         NOP
        mulz.w VF22,VF22,VF21z     NOP
        NOP                         b VU1_ColorDone
        NOP                         NOP
VU1_Overlay:
        NOP                         lq VF22,VU_FOG_COLOR(VI00)
        subz.w VF22,VF07,VF21z     NOP
        VU_WAIT 3
        mulw.w VF22,VF22,VF10w     NOP
VU1_ColorDone:
        ftoi4.xyz VF23,VF23         sq VF23,2(VI09)
        add VF22,VF22,VF16          NOP
        mulw.w VF23,VF23,VF05w     NOP
        NOP                         ilw.w VI06,VU_COUNTS(VI00)
        NOP                         NOP
        NOP                         iaddiu VI13,VI00,1
        NOP                         iand VI06,VI06,VI13
        NOP                         NOP
        NOP                         iblez VI06,VU1_FogStored
        NOP                         NOP
        NOP                         lq VF15,VU_FOG_COLOR(VI00)
        subz.w VF15,VF07,VF21z     NOP
        mulw.w VF15,VF15,VF10w     NOP
        addw VF15,VF15,VF16w       NOP
        ftoi0 VF15,VF15             NOP
        NOP                         sq VF15,0(VI07)
        NOP                         iaddiu VI07,VI07,1
VU1_FogStored:
        addw.z VF21,VF00,VF21w     NOP
        VU_WAIT 2
        addw.w VF23,VF23,VF16w     NOP
        ftoi0 VF22,VF22             NOP
        ftoi4.w VF23,VF23           NOP
        NOP                         sq VF21,0(VI10)
        NOP                         sq VF22,1(VI10)
        NOP                         sq VF23,2(VI10)
        NOP                         iaddiu VI09,VI09,3
        NOP                         iaddiu VI10,VI10,3
        NOP                         isubiu VI05,VI05,1
        NOP                         NOP
        NOP                         ibne VI05,VI00,VU1_Project
        NOP                         NOP
VU1_ProjectEnd:
        NOP                         ilw.z VI06,VU_COUNTS(VI00)
        NOP                         NOP
        NOP                         ibeq VI06,VI00,VU1_ProjectKick
        NOP                         NOP
        NOP                         ilw.w VI12,VU_COUNTS(VI00)
        NOP                         iaddiu VI13,VI00,VU_FLAG_BATCH
        NOP                         iand VI12,VI12,VI13
        NOP                         NOP
        NOP                         ibne VI12,VI00,VU1_AppendPassTriangles
        NOP                         NOP
        NOP                         b VU1_Passes
        NOP                         NOP
VU1_ProjectKick:
        NOP                         xgkick VI03
        NOP                         iaddiu VI13,VI00,VU_PACKET_TOGGLE
        NOP                         isub VI03,VI13,VI03
        NOP                         b VU1_TriangleDone
        NOP                         NOP
VU1_Passes:
        NOP                         iaddiu VI04,VI00,VU_PASSES
VU1_Pass:
        NOP                         lq VF20,1(VI04)
        NOP                         lq VF21,2(VI04)
        NOP                         lq VF22,3(VI04)
        NOP                         lq VF23,4(VI04)
        NOP                         lq VF24,5(VI04)
        NOP                         lq VF25,6(VI04)
        NOP                         sq VF20,0(VI03)
        NOP                         sq VF21,1(VI03)
        NOP                         sq VF22,2(VI03)
        NOP                         sq VF23,3(VI03)
        NOP                         sq VF24,4(VI03)
        NOP                         sq VF25,5(VI03)
        NOP                         iaddiu VI10,VI03,6
        NOP                         ilw.x VI12,0(VI04)
        NOP                         NOP
        NOP                         isubiu VI13,VI12,4
        NOP                         NOP
        NOP                         ibeq VI13,VI00,VU1_PassKick
        NOP                         NOP
        NOP                         iaddiu VI13,VI11,0x4000
        NOP                         iaddiu VI13,VI13,0x4000
        NOP                         isw.x VI13,5(VI03)
        NOP                         iaddiu VI09,VI00,VU_PROJECTED
        NOP                         iaddiu VI07,VI00,VU_FOG_VERTICES
        NOP                         iadd VI08,VI11,VI00
        NOP                         ibeq VI12,VI00,VU1_PassVertex
        NOP                         isubiu VI13,VI12,2
        NOP                         NOP
        NOP                         ibeq VI13,VI00,VU1_PassFogVertex
        NOP                         NOP
        sub VF21,VF00,VF00          isubiu VI13,VI12,3
        NOP                         NOP
        NOP                         ibne VI13,VI00,VU1_PassSolidVertex
        NOP                         NOP
        NOP                         mfir.w VF21,VI15
        NOP                         NOP
        NOP                         b VU1_PassSolidVertex
        NOP                         NOP
.macro vril_pass_vertex name, color
\name:
        NOP                         lq VF20,0(VI09)
.if \color == 0
        NOP                         lq VF21,1(VI09)
.elseif \color == 2
        NOP                         lq VF21,0(VI07)
.else
        NOP                         NOP
.endif
        NOP                         lq VF22,2(VI09)
        NOP                         NOP
        NOP                         sq VF20,0(VI10)
        NOP                         sq VF21,1(VI10)
        NOP                         sq VF22,2(VI10)
        NOP                         iaddiu VI09,VI09,3
        NOP                         iaddiu VI07,VI07,1
        NOP                         iaddiu VI10,VI10,3
        NOP                         isubiu VI08,VI08,1
        NOP                         NOP
        NOP                         ibne VI08,VI00,\name
        NOP                         NOP
        NOP                         b VU1_PassKick
        NOP                         NOP
.endm
        vril_pass_vertex VU1_PassVertex,0
        vril_pass_vertex VU1_PassFogVertex,2
        vril_pass_vertex VU1_PassSolidVertex,1
VU1_PassKick:
        NOP                         xgkick VI03
        NOP                         iaddiu VI13,VI00,VU_PACKET_TOGGLE
        NOP                         isub VI03,VI13,VI03
        NOP                         iaddiu VI04,VI04,7
        NOP                         isubiu VI06,VI06,1
        NOP                         NOP
        NOP                         ibne VI06,VI00,VU1_Pass
        NOP                         NOP
        NOP                         ilw.w VI12,VU_COUNTS(VI00)
        NOP                         iaddiu VI13,VI00,VU_FLAG_BATCH
        NOP                         iand VI12,VI12,VI13
        NOP                         NOP
        NOP                         ibne VI12,VI00,VU1_PassBatchReturn
        NOP                         NOP
VU1_TriangleDone:
        NOP                         isubiu VI02,VI02,1
        NOP                         ilw.x VI01,VU_ENTRY(VI00)
        NOP                         NOP
        NOP                         ibeq VI02,VI00,VU1_FinishTriangles
        NOP                         NOP
        NOP                         jr VI01
        NOP                         NOP
VU1_FinishTriangles:
        NOP                         ilw.z VI06,VU_COUNTS(VI00)
        NOP                         NOP
        NOP                         ibeq VI06,VI00,VU1_EndTriangles
        NOP                         NOP
        NOP                         bal VI12,VU1_FlushPassBatch
        NOP                         NOP
        NOP                         b VU1_End
        NOP                         NOP
VU1_EndTriangles:
        NOP                         bal VI12,VU1_FlushTriangles
        NOP                         NOP
VU1_End:
        NOP                         isw.z VI03,VU_ENTRY(VI00)
        NOP[E]                      NOP
        NOP                         NOP
VU1_WorldBegin:
        NOP                         lq VF27,VU_BATCH_GIFTAG(VI00)
        NOP                         lq VF18,VU_COLOR(VI00)
        NOP                         ilw.w VI08,VU_ALIAS_PARAMS(VI00)
        NOP                         iaddiu VI09,VI00,VU_WORK
        NOP                         NOP
        maxx VF18,VF18,VF00x       NOP
        miniw VF18,VF18,VF00w      NOP
        mul VF18,VF18,VF10         NOP
VU1_WorldTransform:
        NOP                         lq VF20,0(VI14)
        NOP                         lq VF21,2(VI14)
        VU_WAIT 2
        mulax ACC,VF01,VF20x        NOP
        madday ACC,VF02,VF20y       NOP
        maddaz ACC,VF03,VF20z       NOP
        maddw VF23,VF04,VF20w       NOP
        mul.xy VF21,VF21,VF11      NOP
        VU_WAIT 3
        addz.x VF21,VF21,VF11z     NOP
        addw.y VF21,VF21,VF11w     NOP
        subw.z VF21,VF07,VF23w     NOP
        mulx.z VF21,VF21,VF07x     NOP
