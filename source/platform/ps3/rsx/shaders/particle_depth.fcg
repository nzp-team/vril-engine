float
unpack_depth(float4 sample_value)
{
    return dot(sample_value.arg,
             float3(16711680.0 / 16777215.0, 65280.0 / 16777215.0, 255.0 / 16777215.0));
}

float4
main(float2 position : WPOS, uniform sampler2D image : TEXUNIT0, out float depth : DEPTH)
    : COLOR
{
    float2 uv = float2(position.x / 960.0, 1.0 - position.y / 540.0);
    float2 d  = float2(0.5 / 1920.0, 0.5 / 1080.0);
    float a   = unpack_depth(tex2D(image, uv + float2(-d.x, -d.y)));
    float b   = unpack_depth(tex2D(image, uv + float2(d.x, -d.y)));
    float c   = unpack_depth(tex2D(image, uv + float2(-d.x, d.y)));
    float e   = unpack_depth(tex2D(image, uv + float2(d.x, d.y)));

    depth = min(min(a, b), min(c, e));
    return 0;
}
