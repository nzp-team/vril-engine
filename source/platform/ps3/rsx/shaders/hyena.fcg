float4
main(float2 uv : TEXCOORD0, float4 color : COLOR0, float4 fog : TEXCOORD1,
  float4 params : TEXCOORD2, float4 flags : TEXCOORD3, uniform sampler2D image : TEXUNIT0)
    : COLOR
{
    float4 result = color;

    #if TEXTURED
    float4 texel = tex2D(image, uv);
    result = flags.x > 0.5 ? texel * color : texel;
    #endif
    #if ALPHA_TEST

    if (result.a <= params.z)
        discard;

    #endif
    #if FOG
    result.rgb = lerp(fog.rgb, result.rgb, fog.a);
    #endif
    return result;
}
