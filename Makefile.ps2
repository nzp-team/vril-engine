TARGET      := nzportable
BUILD       := build/ps2
EE_BIN      := $(BUILD)/$(TARGET).elf
EE_OPTFLAGS ?= -O3 -fno-math-errno -fsingle-precision-constant -flto=auto
.DEFAULT_GOAL := all

ifndef PS2SDK
$(error PS2SDK is not set)
endif

GIT_VERSION := $(shell git describe --abbrev=6 --dirty --always --tags)

COMMON_OBJS = \
	source/system.o \
	source/startup.o \
	source/tests/test_handler.o \
	source/tests/test_map_boot.o \
	source/tests/test_restart.o \
	source/tests/test_qcvm.o \
	source/tests/test_pathfind.o \
	source/chase.o \
	source/cl_demo.o \
	source/cl_input.o \
	source/cl_main.o \
	source/cl_parse.o \
	source/cl_tent.o \
	source/cl_slist.o \
	source/cmd.o \
	source/common.o \
	source/asset_cache.o \
	source/menu/menu_sys.o \
	source/menu/menu.o \
	source/menu/menu_custommaps.o \
	source/menu/menu_helper.o \
	source/menu/menu_main.o \
	source/menu/menu_stockmaps.o \
	source/menu/menu_lobby.o \
	source/menu/menu_gamesettings.o \
	source/menu/menu_configuration.o \
	source/menu/menu_storage.o \
	source/menu/menu_video.o \
	source/menu/menu_audio.o \
	source/menu/menu_controls.o \
	source/menu/menu_bindings.o \
	source/menu/menu_accessibility.o \
	source/menu/menu_pause.o \
	source/menu/menu_loadscreen.o \
	source/menu/menu_bios.o \
	source/menu/menu_credits.o \
	source/console.o \
	source/crc.o \
	source/cvar.o \
	source/host.o \
	source/host_cmd.o \
	source/keys.o \
	source/mathlib.o \
	source/matrixlib.o \
	source/platform/ps2/net_dgrm.o \
	source/net_loop.o \
	source/platform/ps2/net_main.o \
	source/net_vcr.o \
	source/qcvm/pr_cmds.o \
	source/qcvm/pr_json.o \
	source/qcvm/cJSON.o \
	source/qcvm/pr_edict.o \
	source/qcvm/pr_exec.o \
	source/snd_dma.o \
	source/snd_mem.o \
	source/snd_mix.o \
	source/render/r_hud.o \
	source/sv_main.o \
	source/sv_move.o \
	source/sv_phys.o \
	source/sv_user.o \
	source/view.o \
	source/wad.o \
	source/world.o \
	source/zone.o \
	source/crypter.o \
	source/render/r_fog.o \
	source/render/r_entity_fragments.o \
	source/render/r_color_quantization.o \
	source/render/r_light.o \
	source/render/r_draw.o \
	source/render/r_texture.o \
	source/render/r_pixels.o \
	source/render/r_dxt.o \
	source/render/r_mdl.o \
	source/render/r_surface.o \
	source/render/r_sky.o \
	source/render/r_world.o \
	source/render/r_particles.o \
	source/render/r_decals.o \
	source/platform/ps2/gs/gs_hyena.o \
	source/platform/ps2/gs/gs_vu1_program.o \
	source/images.o \
	source/platform/ps2/sys_ps2.o \
	source/platform/ps2/sys_profile.o \
	source/platform/ps2/sys_memory.o \
	source/render/r_mesh.o \
	source/render/r_model.o \
	source/render/r_model_hardware.o \
	source/platform/ps2/gs/gs_lightmap.o \
	source/render/r_main.o \
	source/render/r_misc.o \
	source/render/r_surf.o \
	source/render/r_screen.o \
	source/render/r_warp.o \
	source/platform/ps2/music.o \
	source/snd_music.o \
	source/platform/ps2/snd_ps2.o \
	source/input.o \
	source/platform/ps2/in_ps2.o \
	source/platform/ps2/gs/gs_vidps2.o \
	source/platform/ps2/net_none.o

IOP_MODULES = iomanX fileXio bdm bdmfs_fatfs usbd usbmass_bd audsrv sio2man padman
IOP_OBJS = $(addprefix $(BUILD)/,$(addsuffix _irx.o,$(IOP_MODULES)))
EE_OBJS = $(addprefix $(BUILD)/,$(COMMON_OBJS)) $(IOP_OBJS)
EE_INCS = -I$(PS2SDK)/ports/include -I$(PS2DEV)/gsKit/include
EE_CFLAGS = -std=gnu99 -fsigned-char -fcommon -fno-strict-aliasing \
	-DGLQUAKE -D__PS2__ -DPLATFORM_SUPPORTS_RUMBLE -DPLATFORM_HAS_PRES_SENS_INPUTS -DPLATFORM_USES_FRAME_DEADLINES -DAREA_DEPTH=7 -DPLATFORM_KEYBOARD_OSK -DPLATFORM_USES_PROJECTION_WIDESCREEN \
	-DPLATFORM_DIRECTORY=ps2 -DPLATFORM_RENDERER=gs -DMAX_AI_COUNT=24 \
	-DGIT_VERSION=\"$(GIT_VERSION)\"
EE_LDFLAGS = -L$(PS2SDK)/ports/lib -L$(PS2DEV)/gsKit/lib -Wl,--defsym=_stack_size=0x100000
EE_LIBS = -Wl,--start-group -lgskit -ldmakit -lpacket2 -lmath3d -lmpg123 \
	-lfileXio -laudsrv -lpad -ldma -ldebug -leedebug -lpatches -lm -Wl,--end-group

ifeq ($(WERROR),1)
EE_CFLAGS += -Werror
endif

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal

.PHONY: all clean
all: $(EE_BIN)

$(BUILD)/source/%.o: source/%.c $(BUILD)/_build_info.h Makefile.ps2
	@mkdir -p $(@D)
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -I$(BUILD) -MMD -MP -c $< -o $@

$(BUILD)/source/platform/ps2/gs/gs_vu1_program.o: source/platform/ps2/gs/gs_vu1.vsm source/platform/ps2/gs/gs_vu1_layout.h
	@mkdir -p $(@D)
	$(EE_CC) -E -P -x assembler-with-cpp $< -o $(@D)/gs_vu1.vsm
	$(PS2DEV)/dvp/bin/dvp-as $(@D)/gs_vu1.vsm -o $@

$(BUILD)/_build_info.h:
	@mkdir -p $(@D)
	@echo '#define GIT_HASH "$(shell git rev-parse --short HEAD)"' > $@
	@echo '#define GIT_BRANCH "$(shell git rev-parse --abbrev-ref HEAD)"' >> $@
	@echo '#define BUILD_DATE "$(shell date -u +"%Y-%m-%dT%H:%M:%SZ")"' >> $@

$(BUILD)/%_irx.c: $(PS2SDK)/iop/irx/%.irx
	@mkdir -p $(@D)
	$(PS2SDK)/bin/bin2c $< $@ $*_irx

$(IOP_OBJS): $(BUILD)/%_irx.o: $(BUILD)/%_irx.c
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@

$(BUILD)/source/platform/ps2/sys_memory.o: source/platform/ps2/sys_memory.S Makefile.ps2
	@mkdir -p $(dir $@)
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@

$(BUILD)/source/platform/ps2/gs/gs_lightmap.o: source/platform/ps2/gs/gs_lightmap.S Makefile.ps2
	@mkdir -p $(dir $@)
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@

clean:
	rm -rf $(BUILD)

-include $(EE_OBJS:.o=.d)
